{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtenDash inbox event (v1)",
  "description": "A batch of record changes at inbox/<sourceId>/<timestamp>_<origin>_<rand>.json.",
  "type": "object",
  "required": ["schemaVersion", "sourceId", "origin", "createdAt", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" },
    "origin": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$",
      "description": "Writer of the event: a device id, extension id, or `app`."
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "records": {
      "type": "array",
      "items": { "$ref": "record.schema.json" }
    }
  },
  "additionalProperties": false
}
